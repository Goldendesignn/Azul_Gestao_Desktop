{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Azul Gestao Desktop",
  "version": "0.1.0",
  "identifier": "ao.azulgestao.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [{
      "title": "Azul Gestao Desktop",
      "width": 1280,
      "height": 800,
      "minWidth": 1024,
      "minHeight": 680
    }],
    "security": { "csp": "default-src 'self'; style-src 'self' 'unsafe-inline';" }
  },
  "bundle": {
    "active": true,
    "targets": "nsis",
    "windows": { "webviewInstallMode": { "type": "embedBootstrapper" } }
  }
}
